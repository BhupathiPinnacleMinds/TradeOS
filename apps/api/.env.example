NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradieos?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
APP_URL=http://localhost:8081
APP_PUBLIC_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006
EMAIL_PROVIDER=console
CUSTOMER_COMMUNICATIONS_ENABLED=true
CUSTOMER_EMAIL_PROVIDER=local
CUSTOMER_SMS_PROVIDER=local
CUSTOMER_COMMUNICATION_WORKER_ENABLED=false
CUSTOMER_COMMUNICATION_WORKER_INTERVAL_SECONDS=300
CUSTOMER_COMMUNICATION_WORKER_BATCH_SIZE=50
RESEND_API_KEY=
EMAIL_FROM_NAME=TradieOS
EMAIL_FROM_ADDRESS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_FROM=
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=.local-storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300
