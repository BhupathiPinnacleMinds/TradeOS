generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  OFFICE_MANAGER
  SCHEDULER
  TECHNICIAN
  ACCOUNTANT
  SALES
  READ_ONLY
  STAFF
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum ContactPreference {
  PHONE
  SMS
  EMAIL
  ANY
}

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
  REAL_ESTATE
  STRATA
  BUILDER
  OTHER
}

enum JobStatus {
  NEW
  SCHEDULED
  ON_THE_WAY
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentType {
  INSPECTION
  INSTALLATION
  MAINTENANCE
  RETURN_VISIT
  EMERGENCY_VISIT
}

enum AppointmentLocationSource {
  CUSTOMER_SITE
  CUSTOMER_DEFAULT
  MANUAL
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum MessageChannel {
  SMS
  EMAIL
  INTERNAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  DRAFT
  AWAITING_CONFIRMATION
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum AiActionType {
  SEND_SMS
  SEND_EMAIL
  SEND_QUOTE
  SEND_INVOICE
}

enum AiActionStatus {
  DRAFT
  AWAITING_CONFIRMATION
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model Business {
  id              String           @id @default(cuid())
  name            String
  abn             String?
  tradeType       String?
  gstRegistered   Boolean          @default(false)
  phone           String?
  email           String?
  address         String?
  suburb          String?
  state           String?
  postcode        String?
  timezone        String           @default("Australia/Sydney")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  members         BusinessMember[]
  customers       Customer[]
  customerSites   CustomerSite[]
  jobs            Job[]
  jobSequence     JobSequence?
  appointments    Appointment[]
  appointmentWorkLogs AppointmentWorkLog[]
  appointmentSequence AppointmentSequence?
  quotes          Quote[]
  invoices        Invoice[]
  payments        Payment[]
  messages        Message[]
  notifications   Notification[]
  aiConversations AiConversation[]
  aiMessages      AiMessage[]
  aiActions       AiAction[]
  documents       Document[]
  integrations    Integration[]
  auditLogs       AuditLog[]
}

model User {
  id              String           @id @default(cuid())
  businessId      String
  email           String
  passwordHash    String           @default("")
  firstName       String
  lastName        String
  role            Role             @default(STAFF)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships     BusinessMember[]
  invitedMembers  BusinessMember[] @relation("MemberInviter")
  createdCustomers Customer[]       @relation("CustomerCreator")
  updatedCustomers Customer[]       @relation("CustomerUpdater")
  assignedJobs     Job[]            @relation("JobAssignee")
  assignedAppointments Appointment[] @relation("AppointmentAssignee")
  appointmentWorkLogs AppointmentWorkLog[] @relation("AppointmentWorkLogTechnician")
  createdJobs      Job[]            @relation("JobCreator")
  updatedJobs      Job[]            @relation("JobUpdater")
  createdAppointments Appointment[] @relation("AppointmentCreator")
  updatedAppointments Appointment[] @relation("AppointmentUpdater")
  auditLogs       AuditLog[]       @relation("AuditActor")
  notifications   Notification[]
  aiConversations AiConversation[]

  @@unique([businessId, email])
  @@unique([id, businessId])
  @@index([businessId, role])
}

model BusinessMember {
  id           String       @id @default(cuid())
  businessId   String
  userId       String?
  role         Role
  status       MemberStatus @default(INVITED)
  invitedEmail String
  invitedFirstName String?
  invitedLastName  String?
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  inviteAcceptedAt DateTime?
  inviteCancelledAt DateTime?
  inviteEmailDeliveryStatus String? @default("PENDING")
  inviteEmailDeliveryError  String?
  invitedBy    String?
  invitedAt    DateTime?
  joinedAt     DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  inviter      User?        @relation("MemberInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([businessId, userId])
  @@unique([businessId, invitedEmail])
  @@index([businessId, role])
  @@index([businessId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, action, createdAt])
  @@index([businessId, entityType, entityId])
}

model Customer {
  id                String            @id @default(cuid())
  businessId        String
  firstName         String?
  lastName          String?
  displayName       String
  companyName       String?
  email             String?
  emailNormalised   String?
  phone             String?
  phoneNormalised   String?
  alternatePhone    String?
  addressLine1      String?
  addressLine2      String?
  suburb            String?
  state             String?
  postcode          String?
  contactPreference ContactPreference @default(ANY)
  customerType      CustomerType      @default(RESIDENTIAL)
  notes             String?
  tags              String[]          @default([])
  isArchived        Boolean           @default(false)
  archivedAt        DateTime?
  createdBy         String?
  updatedBy         String?
  status            CustomerStatus    @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator           User?             @relation("CustomerCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater           User?             @relation("CustomerUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  sites             CustomerSite[]
  jobs              Job[]
  quotes            Quote[]
  invoices          Invoice[]
  messages          Message[]

  @@unique([id, businessId])
  @@index([businessId, isArchived])
  @@index([businessId, customerType])
  @@index([businessId, state, suburb])
  @@index([businessId, emailNormalised])
  @@index([businessId, phoneNormalised])
  @@index([businessId, lastName, firstName])
}

model CustomerSite {
  id                 String   @id @default(cuid())
  businessId         String
  customerId         String
  label              String
  addressLine1       String
  addressLine2       String?
  suburb             String
  state              String
  postcode           String
  accessInstructions String?
  siteContactName    String?
  siteContactPhone   String?
  isPrimary          Boolean  @default(false)
  isArchived         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Cascade)
  appointments       Appointment[]

  @@unique([id, businessId])
  @@index([businessId, customerId, isArchived])
  @@index([businessId, state, suburb])
}

model Job {
  id                       String      @id @default(cuid())
  businessId               String
  customerId               String
  assignedToUserId         String?
  jobNumber                String
  title                    String
  description              String?
  tradeType                String?
  status                   JobStatus   @default(NEW)
  priority                 JobPriority @default(NORMAL)
  scheduledStart           DateTime
  scheduledEnd             DateTime?
  estimatedDurationMinutes Int?
  actualStart              DateTime?
  actualEnd                DateTime?
  completedAt              DateTime?
  addressLine1             String
  addressLine2             String?
  suburb                   String
  state                    String
  postcode                 String
  accessInstructions       String?
  customerNotes            String?
  internalNotes            String?
  requiresQuote            Boolean     @default(false)
  requiresInvoice          Boolean     @default(false)
  invoiceCreated           Boolean     @default(false)
  quoteCreated             Boolean     @default(false)
  isArchived               Boolean     @default(false)
  archivedAt               DateTime?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  business                 Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer                 Customer    @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  assignedTo               User?       @relation("JobAssignee", fields: [assignedToUserId, businessId], references: [id, businessId], onDelete: SetNull)
  creator                  User?       @relation("JobCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater                  User?       @relation("JobUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  quotes                   Quote[]
  invoices                 Invoice[]
  messages                 Message[]
  documents                Document[]
  appointments             Appointment[]
  workLogs                 AppointmentWorkLog[]

  @@unique([businessId, jobNumber])
  @@unique([id, businessId])
  @@index([businessId, status, scheduledStart])
  @@index([businessId, priority, scheduledStart])
  @@index([businessId, assignedToUserId, scheduledStart])
  @@index([businessId, customerId])
  @@index([businessId, isArchived])
}

model JobSequence {
  businessId String   @id
  nextNumber Int      @default(1)
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Appointment {
  id                       String            @id @default(cuid())
  businessId               String
  jobId                    String
  customerSiteId           String?
  assignedUserId           String?
  appointmentNumber        String
  appointmentType          AppointmentType   @default(INSPECTION)
  locationSource           AppointmentLocationSource @default(CUSTOMER_DEFAULT)
  status                   AppointmentStatus @default(SCHEDULED)
  scheduledStart           DateTime
  scheduledEnd             DateTime
  actualStart              DateTime?
  actualEnd                DateTime?
  estimatedDurationMinutes Int?
  travelDurationMinutes    Int?
  travelDistanceKm         Decimal?          @db.Decimal(8, 2)
  addressLine1             String
  addressLine2             String?
  suburb                   String
  state                    String
  postcode                 String
  accessInstructions       String?
  notes                    String?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  business                 Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job                      Job               @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: Cascade)
  customerSite             CustomerSite?     @relation(fields: [customerSiteId, businessId], references: [id, businessId], onDelete: NoAction)
  assignedUser             User?             @relation("AppointmentAssignee", fields: [assignedUserId, businessId], references: [id, businessId], onDelete: SetNull)
  creator                  User?             @relation("AppointmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater                  User?             @relation("AppointmentUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  workLogs                 AppointmentWorkLog[]

  @@unique([businessId, appointmentNumber])
  @@unique([id, businessId])
  @@index([businessId, jobId])
  @@index([businessId, customerSiteId])
  @@index([businessId, assignedUserId, scheduledStart])
  @@index([businessId, status, scheduledStart])
}

model AppointmentWorkLog {
  id                 String      @id @default(cuid())
  businessId         String
  appointmentId      String
  jobId              String
  technicianUserId   String
  technicianNotes    String?
  workCompleted      String?
  followUpRequired   Boolean     @default(false)
  followUpNotes      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  business           Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment        Appointment @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)
  job                Job         @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: Cascade)
  technician         User        @relation("AppointmentWorkLogTechnician", fields: [technicianUserId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, appointmentId])
  @@index([businessId, jobId, createdAt])
  @@index([businessId, technicianUserId, createdAt])
}

model AppointmentSequence {
  businessId String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Quote {
  id         String      @id @default(cuid())
  businessId String
  customerId String
  jobId      String?
  number     String
  status     QuoteStatus @default(DRAFT)
  issueDate  DateTime    @default(now())
  expiryDate DateTime?
  subtotal   Decimal     @db.Decimal(12, 2)
  gst        Decimal     @db.Decimal(12, 2)
  total      Decimal     @db.Decimal(12, 2)
  notes      String?
  sentAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  job        Job?        @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: SetNull)
  lineItems  QuoteLineItem[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, issueDate])
  @@index([businessId, customerId])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  businessId  String
  quoteId     String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)
  quote       Quote   @relation(fields: [quoteId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, quoteId])
}

model Invoice {
  id         String        @id @default(cuid())
  businessId String
  customerId String
  jobId      String?
  number     String
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @default(now())
  dueDate    DateTime
  subtotal   Decimal       @db.Decimal(12, 2)
  gst        Decimal       @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  amountPaid Decimal       @default(0) @db.Decimal(12, 2)
  notes      String?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  job        Job?          @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: SetNull)
  lineItems  InvoiceLineItem[]
  payments   Payment[]

  @@unique([businessId, number])
  @@unique([id, businessId])
  @@index([businessId, status, dueDate])
  @@index([businessId, customerId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  businessId  String
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, invoiceId])
}

model Payment {
  id         String        @id @default(cuid())
  businessId String
  invoiceId  String
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(PENDING)
  method     PaymentMethod
  reference  String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice    Invoice       @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, status, paidAt])
  @@index([businessId, invoiceId])
}

model Message {
  id          String           @id @default(cuid())
  businessId  String
  customerId  String?
  jobId       String?
  channel     MessageChannel
  direction   MessageDirection
  status      MessageStatus    @default(DRAFT)
  recipient   String?
  subject     String?
  body        String
  confirmedBy String?
  confirmedAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer?        @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: SetNull)
  job         Job?             @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: SetNull)

  @@index([businessId, status, createdAt])
  @@index([businessId, customerId])
}

model Notification {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  title      String
  body       String
  status     NotificationStatus @default(UNREAD)
  readAt     DateTime?
  createdAt  DateTime           @default(now())
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, userId, status])
}

model AiConversation {
  id         String     @id @default(cuid())
  businessId String
  userId     String
  title      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId, businessId], references: [id, businessId], onDelete: Cascade)
  messages   AiMessage[]
  actions    AiAction[]

  @@unique([id, businessId])
  @@index([businessId, userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  businessId     String
  conversationId String
  role           AiMessageRole
  content        String
  createdAt      DateTime       @default(now())
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   AiConversation @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, conversationId, createdAt])
}

model AiAction {
  id             String         @id @default(cuid())
  businessId     String
  conversationId String
  type           AiActionType
  status         AiActionStatus @default(DRAFT)
  payload        Json
  confirmedBy    String?
  confirmedAt    DateTime?
  executedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   AiConversation @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, status, createdAt])
  @@index([businessId, conversationId])
}

model Document {
  id         String   @id @default(cuid())
  businessId String
  jobId      String?
  name       String
  mimeType   String
  storageKey String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job        Job?     @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: SetNull)

  @@unique([businessId, storageKey])
  @@index([businessId, jobId])
}

model Integration {
  id          String   @id @default(cuid())
  businessId  String
  provider    String
  externalId  String?
  credentials Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@index([businessId, isActive])
}
