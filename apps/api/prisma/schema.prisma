generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  OFFICE_MANAGER
  SCHEDULER
  TECHNICIAN
  ACCOUNTANT
  SALES
  READ_ONLY
  STAFF
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum ContactPreference {
  PHONE
  SMS
  EMAIL
  ANY
}

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
  REAL_ESTATE
  STRATA
  BUILDER
  OTHER
}

enum JobStatus {
  NEW
  SCHEDULED
  ON_THE_WAY
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentType {
  INSPECTION
  INSTALLATION
  MAINTENANCE
  RETURN_VISIT
  EMERGENCY_VISIT
}

enum AppointmentLocationSource {
  CUSTOMER_SITE
  CUSTOMER_DEFAULT
  MANUAL
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  CONVERTED
}

enum QuotePricingMode {
  GST_EXCLUSIVE
  GST_INCLUSIVE
}

enum QuoteDiscountType {
  NONE
  FIXED
  PERCENTAGE
}

enum QuoteDepositType {
  NONE
  FIXED
  PERCENTAGE
}

enum QuoteLineItemType {
  LABOUR
  MATERIAL
  SERVICE
  FEE
  DISCOUNT
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  EFTPOS
  CHEQUE
  OTHER
}

enum MessageChannel {
  SMS
  EMAIL
  INTERNAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  DRAFT
  AWAITING_CONFIRMATION
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum CustomerCommunicationChannel {
  EMAIL
  SMS
}

enum CustomerCommunicationStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum CustomerCommunicationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  QUOTE_SENT
  QUOTE_FOLLOW_UP
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  INVOICE_SENT
  INVOICE_DUE_SOON
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  JOB_COMPLETED
  MANUAL_MESSAGE
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum AiActionType {
  SEND_SMS
  SEND_EMAIL
  SEND_QUOTE
  SEND_INVOICE
}

enum AiActionStatus {
  DRAFT
  AWAITING_CONFIRMATION
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MediaCategory {
  BEFORE_PHOTO
  PROGRESS_PHOTO
  AFTER_PHOTO
  DAMAGE_EVIDENCE
  CUSTOMER_SUPPLIED
  COMPLIANCE_CERTIFICATE
  WARRANTY
  PLAN_DRAWING
  PERMIT
  RECEIPT
  MATERIAL_INVOICE
  GENERAL_DOCUMENT
  OTHER
}

enum MediaType {
  IMAGE
  PDF
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

enum UploadStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProcessingStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

model Business {
  id                       String                            @id @default(cuid())
  name                     String
  abn                      String?
  tradeType                String?
  gstRegistered            Boolean                           @default(false)
  phone                    String?
  email                    String?
  address                  String?
  suburb                   String?
  state                    String?
  postcode                 String?
  timezone                 String                            @default("Australia/Melbourne")
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  users                    User[]
  members                  BusinessMember[]
  customers                Customer[]
  customerSites            CustomerSite[]
  jobs                     Job[]
  jobSequence              JobSequence?
  appointments             Appointment[]
  appointmentWorkLogs      AppointmentWorkLog[]
  appointmentSignatures    AppointmentSignature[]
  appointmentSequence      AppointmentSequence?
  quotes                   Quote[]
  quoteSequence            QuoteSequence?
  quoteRevisions           QuoteRevision[]
  quotePdfDocuments        QuotePdfDocument[]
  quotePublicTokens        QuotePublicAccessToken[]
  invoices                 Invoice[]
  invoicePayments          InvoicePayment[]
  invoiceSequence          InvoiceSequence?
  invoicePdfDocuments      InvoicePdfDocument[]
  invoiceReceiptDocuments  InvoiceReceiptDocument[]
  receiptSequence          ReceiptSequence?
  invoicePublicTokens      InvoicePublicAccessToken[]
  communicationSettings    BusinessCommunicationSettings?
  customerCommunications   CustomerCommunication[]
  communicationPreferences CustomerCommunicationPreference[]
  idempotencyRecords       IdempotencyRecord[]
  messages                 Message[]
  notifications            Notification[]
  aiConversations          AiConversation[]
  aiMessages               AiMessage[]
  aiActions                AiAction[]
  documents                Document[]
  mediaAssets              MediaAsset[]
  integrations             Integration[]
  auditLogs                AuditLog[]
}

model IdempotencyRecord {
  id              String            @id @default(cuid())
  businessId      String?
  userId          String?
  publicScopeHash String?
  keyHash         String
  operation       String
  requestHash     String
  status          IdempotencyStatus @default(IN_PROGRESS)
  responseStatus  Int?
  responseBody    Json?
  errorCode       String?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?
  expiresAt       DateTime
  updatedAt       DateTime          @updatedAt
  business        Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, operation, keyHash])
  @@unique([publicScopeHash, operation, keyHash])
  @@index([status, expiresAt])
  @@index([businessId, operation, createdAt])
}

model User {
  id                             String                   @id @default(cuid())
  businessId                     String
  email                          String
  passwordHash                   String                   @default("")
  firstName                      String
  lastName                       String
  role                           Role                     @default(STAFF)
  isActive                       Boolean                  @default(true)
  authVersion                    Int                      @default(0)
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  business                       Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships                    BusinessMember[]
  invitedMembers                 BusinessMember[]         @relation("MemberInviter")
  createdCustomers               Customer[]               @relation("CustomerCreator")
  updatedCustomers               Customer[]               @relation("CustomerUpdater")
  assignedJobs                   Job[]                    @relation("JobAssignee")
  assignedAppointments           Appointment[]            @relation("AppointmentAssignee")
  appointmentWorkLogs            AppointmentWorkLog[]     @relation("AppointmentWorkLogTechnician")
  capturedAppointmentSignatures  AppointmentSignature[]   @relation("AppointmentSignatureCapturedBy")
  uploadedMediaAssets            MediaAsset[]             @relation("MediaAssetUploader")
  createdJobs                    Job[]                    @relation("JobCreator")
  updatedJobs                    Job[]                    @relation("JobUpdater")
  createdQuotes                  Quote[]                  @relation("QuoteCreator")
  updatedQuotes                  Quote[]                  @relation("QuoteUpdater")
  createdInvoices                Invoice[]                @relation("InvoiceCreator")
  updatedInvoices                Invoice[]                @relation("InvoiceUpdater")
  createdInvoicePayments         InvoicePayment[]         @relation("InvoicePaymentCreator")
  createdInvoiceReceiptDocuments InvoiceReceiptDocument[] @relation("InvoiceReceiptDocumentCreator")
  createdCustomerCommunications  CustomerCommunication[]  @relation("CustomerCommunicationCreator")
  createdAppointments            Appointment[]            @relation("AppointmentCreator")
  updatedAppointments            Appointment[]            @relation("AppointmentUpdater")
  auditLogs                      AuditLog[]               @relation("AuditActor")
  notifications                  Notification[]
  aiConversations                AiConversation[]
  passwordResetTokens            PasswordResetToken[]

  @@unique([businessId, email])
  @@unique([id, businessId])
  @@index([businessId, role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model BusinessMember {
  id                        String       @id @default(cuid())
  businessId                String
  userId                    String?
  role                      Role
  status                    MemberStatus @default(INVITED)
  invitedEmail              String
  invitedFirstName          String?
  invitedLastName           String?
  inviteTokenHash           String?      @unique
  inviteExpiresAt           DateTime?
  inviteAcceptedAt          DateTime?
  inviteCancelledAt         DateTime?
  inviteEmailDeliveryStatus String?      @default("PENDING")
  inviteEmailDeliveryError  String?
  invitedBy                 String?
  invitedAt                 DateTime?
  joinedAt                  DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  business                  Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  inviter                   User?        @relation("MemberInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([businessId, userId])
  @@unique([businessId, invitedEmail])
  @@index([businessId, role])
  @@index([businessId, status])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, action, createdAt])
  @@index([businessId, entityType, entityId])
}

model Customer {
  id                      String                           @id @default(cuid())
  businessId              String
  firstName               String?
  lastName                String?
  displayName             String
  companyName             String?
  email                   String?
  emailNormalised         String?
  phone                   String?
  phoneNormalised         String?
  alternatePhone          String?
  addressLine1            String?
  addressLine2            String?
  suburb                  String?
  state                   String?
  postcode                String?
  contactPreference       ContactPreference                @default(ANY)
  customerType            CustomerType                     @default(RESIDENTIAL)
  notes                   String?
  tags                    String[]                         @default([])
  isArchived              Boolean                          @default(false)
  archivedAt              DateTime?
  createdBy               String?
  updatedBy               String?
  status                  CustomerStatus                   @default(ACTIVE)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  business                Business                         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator                 User?                            @relation("CustomerCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater                 User?                            @relation("CustomerUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  sites                   CustomerSite[]
  jobs                    Job[]
  quotes                  Quote[]
  invoices                Invoice[]
  communicationPreference CustomerCommunicationPreference?
  communications          CustomerCommunication[]
  messages                Message[]
  mediaAssets             MediaAsset[]

  @@unique([id, businessId])
  @@index([businessId, isArchived])
  @@index([businessId, customerType])
  @@index([businessId, state, suburb])
  @@index([businessId, emailNormalised])
  @@index([businessId, phoneNormalised])
  @@index([businessId, lastName, firstName])
}

model CustomerSite {
  id                 String        @id @default(cuid())
  businessId         String
  customerId         String
  label              String
  addressLine1       String
  addressLine2       String?
  suburb             String
  state              String
  postcode           String
  accessInstructions String?
  siteContactName    String?
  siteContactPhone   String?
  isPrimary          Boolean       @default(false)
  isArchived         Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer      @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Cascade)
  appointments       Appointment[]
  quotes             Quote[]
  invoices           Invoice[]

  @@unique([id, businessId])
  @@index([businessId, customerId, isArchived])
  @@index([businessId, state, suburb])
}

model Job {
  id                       String                  @id @default(cuid())
  businessId               String
  customerId               String
  assignedToUserId         String?
  jobNumber                String
  title                    String
  description              String?
  tradeType                String?
  status                   JobStatus               @default(NEW)
  priority                 JobPriority             @default(NORMAL)
  scheduledStart           DateTime
  scheduledEnd             DateTime?
  estimatedDurationMinutes Int?
  actualStart              DateTime?
  actualEnd                DateTime?
  completedAt              DateTime?
  addressLine1             String
  addressLine2             String?
  suburb                   String
  state                    String
  postcode                 String
  accessInstructions       String?
  customerNotes            String?
  internalNotes            String?
  requiresQuote            Boolean                 @default(false)
  requiresInvoice          Boolean                 @default(false)
  invoiceCreated           Boolean                 @default(false)
  quoteCreated             Boolean                 @default(false)
  sourceQuoteId            String?
  isArchived               Boolean                 @default(false)
  archivedAt               DateTime?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  business                 Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer                 Customer                @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  assignedTo               User?                   @relation("JobAssignee", fields: [assignedToUserId, businessId], references: [id, businessId], onDelete: Restrict)
  creator                  User?                   @relation("JobCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater                  User?                   @relation("JobUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  legacyQuotes             Quote[]                 @relation("QuoteLegacyJob")
  relatedQuotes            Quote[]                 @relation("QuoteRelatedJob")
  convertedQuotes          Quote[]                 @relation("QuoteConvertedJob")
  sourceQuote              Quote?                  @relation("JobSourceQuote", fields: [sourceQuoteId, businessId], references: [id, businessId], onDelete: Restrict)
  invoices                 Invoice[]
  messages                 Message[]
  documents                Document[]
  mediaAssets              MediaAsset[]
  appointments             Appointment[]
  workLogs                 AppointmentWorkLog[]
  appointmentSignatures    AppointmentSignature[]
  communications           CustomerCommunication[]

  @@unique([businessId, jobNumber])
  @@unique([id, businessId])
  @@index([businessId, status, scheduledStart])
  @@index([businessId, priority, scheduledStart])
  @@index([businessId, assignedToUserId, scheduledStart])
  @@index([businessId, customerId])
  @@index([businessId, isArchived])
  @@index([businessId, sourceQuoteId])
}

model JobSequence {
  businessId String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Appointment {
  id                       String                    @id @default(cuid())
  businessId               String
  jobId                    String
  customerSiteId           String?
  assignedUserId           String?
  appointmentNumber        String
  appointmentType          AppointmentType           @default(INSPECTION)
  locationSource           AppointmentLocationSource @default(CUSTOMER_DEFAULT)
  status                   AppointmentStatus         @default(SCHEDULED)
  scheduledStart           DateTime
  scheduledEnd             DateTime
  actualStart              DateTime?
  actualEnd                DateTime?
  travelStartedAt          DateTime?
  arrivedAt                DateTime?
  workStartedAt            DateTime?
  currentWorkStartedAt     DateTime?
  pausedAt                 DateTime?
  completedAt              DateTime?
  totalTravelMinutes       Int                       @default(0)
  totalWorkMinutes         Int                       @default(0)
  totalPausedMinutes       Int                       @default(0)
  estimatedDurationMinutes Int?
  travelDurationMinutes    Int?
  travelDistanceKm         Decimal?                  @db.Decimal(8, 2)
  addressLine1             String
  addressLine2             String?
  suburb                   String
  state                    String
  postcode                 String
  accessInstructions       String?
  notes                    String?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  business                 Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job                      Job                       @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: Cascade)
  customerSite             CustomerSite?             @relation(fields: [customerSiteId, businessId], references: [id, businessId], onDelete: NoAction)
  assignedUser             User?                     @relation("AppointmentAssignee", fields: [assignedUserId, businessId], references: [id, businessId], onDelete: Restrict)
  creator                  User?                     @relation("AppointmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater                  User?                     @relation("AppointmentUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  workLogs                 AppointmentWorkLog[]
  signatures               AppointmentSignature[]
  mediaAssets              MediaAsset[]
  sourceQuotes             Quote[]                   @relation("QuoteSourceAppointment")
  communications           CustomerCommunication[]

  @@unique([businessId, appointmentNumber])
  @@unique([id, businessId])
  @@index([businessId, jobId])
  @@index([businessId, customerSiteId])
  @@index([businessId, assignedUserId, scheduledStart])
  @@index([businessId, status, scheduledStart])
}

model AppointmentSignature {
  id               String      @id @default(cuid())
  businessId       String
  appointmentId    String
  jobId            String
  customerName     String?
  signerTitle      String?
  consentText      String
  signatureData    Json?
  skipReason       String?
  capturedByUserId String
  capturedAt       DateTime?
  skippedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  business         Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment      Appointment @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)
  job              Job         @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: Cascade)
  capturedBy       User        @relation("AppointmentSignatureCapturedBy", fields: [capturedByUserId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, appointmentId])
  @@index([businessId, jobId, createdAt])
  @@index([businessId, capturedByUserId, createdAt])
}

model AppointmentWorkLog {
  id               String      @id @default(cuid())
  businessId       String
  appointmentId    String
  jobId            String
  technicianUserId String
  technicianNotes  String?
  workCompleted    String?
  followUpRequired Boolean     @default(false)
  followUpNotes    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  business         Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment      Appointment @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Cascade)
  job              Job         @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: Cascade)
  technician       User        @relation("AppointmentWorkLogTechnician", fields: [technicianUserId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, appointmentId])
  @@index([businessId, jobId, createdAt])
  @@index([businessId, technicianUserId, createdAt])
}

model AppointmentSequence {
  businessId String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Quote {
  id                   String                   @id @default(cuid())
  businessId           String
  quoteNumber          String
  customerId           String
  customerSiteId       String?
  jobId                String?
  relatedJobId         String?
  convertedJobId       String?
  sourceAppointmentId  String?
  status               QuoteStatus              @default(DRAFT)
  title                String
  description          String?
  issueDate            DateTime                 @default(now())
  expiryDate           DateTime?
  currency             String                   @default("AUD")
  pricingMode          QuotePricingMode         @default(GST_EXCLUSIVE)
  gstRateBasisPoints   Int                      @default(1000)
  subtotalCents        Int                      @default(0)
  discountType         QuoteDiscountType        @default(NONE)
  discountValue        Int                      @default(0)
  discountCents        Int                      @default(0)
  gstCents             Int                      @default(0)
  totalCents           Int                      @default(0)
  depositType          QuoteDepositType         @default(NONE)
  depositValue         Int                      @default(0)
  depositCents         Int                      @default(0)
  customerNotes        String?
  internalNotes        String?
  termsAndConditions   String?
  sentAt               DateTime?
  viewedAt             DateTime?
  firstViewedAt        DateTime?
  latestViewedAt       DateTime?
  viewCount            Int                      @default(0)
  acceptedAt           DateTime?
  declinedAt           DateTime?
  declineReason        String?
  declineComment       String?
  expiredAt            DateTime?
  cancelledAt          DateTime?
  convertedAt          DateTime?
  acceptedByName       String?
  acceptedByEmail      String?
  acceptedQuoteVersion Int?
  acceptanceIp         String?
  version              Int                      @default(1)
  createdBy            String?
  updatedBy            String?
  archivedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  business             Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             Customer                 @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  customerSite         CustomerSite?            @relation(fields: [customerSiteId, businessId], references: [id, businessId], onDelete: Restrict)
  job                  Job?                     @relation("QuoteLegacyJob", fields: [jobId, businessId], references: [id, businessId], onDelete: Restrict)
  relatedJob           Job?                     @relation("QuoteRelatedJob", fields: [relatedJobId, businessId], references: [id, businessId], onDelete: Restrict)
  convertedJob         Job?                     @relation("QuoteConvertedJob", fields: [convertedJobId, businessId], references: [id, businessId], onDelete: Restrict)
  sourceJobs           Job[]                    @relation("JobSourceQuote")
  sourceInvoices       Invoice[]                @relation("InvoiceSourceQuote")
  sourceAppointment    Appointment?             @relation("QuoteSourceAppointment", fields: [sourceAppointmentId, businessId], references: [id, businessId], onDelete: Restrict)
  creator              User?                    @relation("QuoteCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater              User?                    @relation("QuoteUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  lineItems            QuoteLineItem[]
  revisions            QuoteRevision[]
  pdfDocuments         QuotePdfDocument[]
  publicAccessTokens   QuotePublicAccessToken[]
  communications       CustomerCommunication[]

  @@unique([businessId, quoteNumber])
  @@unique([id, businessId])
  @@index([businessId, status, issueDate])
  @@index([businessId, expiryDate])
  @@index([businessId, customerId])
  @@index([businessId, jobId])
  @@index([businessId, relatedJobId])
  @@index([businessId, convertedJobId])
  @@index([businessId, createdBy])
}

model QuoteLineItem {
  id                String            @id @default(cuid())
  businessId        String
  quoteId           String
  position          Int
  type              QuoteLineItemType @default(SERVICE)
  name              String
  description       String?
  quantity          Decimal           @db.Decimal(10, 3)
  unit              String            @default("item")
  unitPriceCents    Int
  taxable           Boolean           @default(true)
  lineSubtotalCents Int               @default(0)
  lineGstCents      Int               @default(0)
  lineTotalCents    Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  quote             Quote             @relation(fields: [quoteId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, quoteId])
  @@index([businessId, quoteId, position])
}

model QuoteRevision {
  id                 String                   @id @default(cuid())
  businessId         String
  quoteId            String
  version            Int
  status             QuoteStatus
  snapshot           Json
  snapshotHash       String?
  reason             String?
  createdBy          String?
  createdAt          DateTime                 @default(now())
  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quote              Quote                    @relation(fields: [quoteId, businessId], references: [id, businessId], onDelete: Cascade)
  pdfDocuments       QuotePdfDocument[]
  publicAccessTokens QuotePublicAccessToken[]

  @@unique([businessId, quoteId, version])
  @@unique([id, businessId])
  @@index([businessId, quoteId, createdAt])
}

model QuotePdfDocument {
  id              String        @id @default(cuid())
  businessId      String
  quoteId         String
  quoteRevisionId String
  version         Int
  fileName        String
  mimeType        String        @default("application/pdf")
  storageProvider String
  objectKey       String
  fileSizeBytes   Int
  checksum        String
  generatedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quote           Quote         @relation(fields: [quoteId, businessId], references: [id, businessId], onDelete: Cascade)
  quoteRevision   QuoteRevision @relation(fields: [quoteRevisionId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, quoteId, version])
  @@unique([businessId, objectKey])
  @@index([businessId, quoteRevisionId])
}

model QuotePublicAccessToken {
  id              String        @id @default(cuid())
  businessId      String
  quoteId         String
  quoteRevisionId String
  version         Int
  tokenHash       String
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  lastViewedAt    DateTime?
  viewCount       Int           @default(0)
  acceptedAt      DateTime?
  declinedAt      DateTime?
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quote           Quote         @relation(fields: [quoteId, businessId], references: [id, businessId], onDelete: Cascade)
  quoteRevision   QuoteRevision @relation(fields: [quoteRevisionId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([businessId, quoteId, version])
  @@index([businessId, quoteRevisionId])
  @@index([expiresAt])
}

model QuoteSequence {
  businessId String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                 String                     @id @default(cuid())
  businessId         String
  invoiceNumber      String
  customerId         String
  customerSiteId     String?
  jobId              String?
  sourceQuoteId      String?
  status             InvoiceStatus              @default(DRAFT)
  title              String
  description        String?
  issueDate          DateTime                   @default(now())
  dueDate            DateTime
  currency           String                     @default("AUD")
  pricingMode        QuotePricingMode           @default(GST_EXCLUSIVE)
  gstRateBasisPoints Int                        @default(1000)
  subtotalCents      Int                        @default(0)
  discountType       QuoteDiscountType          @default(NONE)
  discountValue      Int                        @default(0)
  discountCents      Int                        @default(0)
  gstCents           Int                        @default(0)
  totalCents         Int                        @default(0)
  creditAppliedCents Int                        @default(0)
  amountPaidCents    Int                        @default(0)
  balanceDueCents    Int                        @default(0)
  customerNotes      String?
  internalNotes      String?
  paymentTerms       String?
  sentAt             DateTime?
  viewedAt           DateTime?
  paidAt             DateTime?
  voidedAt           DateTime?
  version            Int                        @default(1)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  business           Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer                   @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  customerSite       CustomerSite?              @relation(fields: [customerSiteId, businessId], references: [id, businessId], onDelete: Restrict)
  job                Job?                       @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: Restrict)
  sourceQuote        Quote?                     @relation("InvoiceSourceQuote", fields: [sourceQuoteId, businessId], references: [id, businessId], onDelete: Restrict)
  creator            User?                      @relation("InvoiceCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater            User?                      @relation("InvoiceUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  lineItems          InvoiceLineItem[]
  payments           InvoicePayment[]
  pdfDocuments       InvoicePdfDocument[]
  receiptDocuments   InvoiceReceiptDocument[]
  publicAccessTokens InvoicePublicAccessToken[]
  communications     CustomerCommunication[]

  @@unique([businessId, invoiceNumber])
  @@unique([id, businessId])
  @@index([businessId, status, dueDate])
  @@index([businessId, customerId])
  @@index([businessId, jobId])
  @@index([businessId, sourceQuoteId])
  @@index([businessId, createdBy])
}

model InvoiceLineItem {
  id                String            @id @default(cuid())
  businessId        String
  invoiceId         String
  position          Int
  type              QuoteLineItemType @default(SERVICE)
  name              String
  description       String?
  quantity          Decimal           @db.Decimal(10, 3)
  unit              String            @default("item")
  unitPriceCents    Int
  taxable           Boolean           @default(true)
  lineSubtotalCents Int               @default(0)
  lineGstCents      Int               @default(0)
  lineTotalCents    Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  invoice           Invoice           @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, invoiceId])
  @@index([businessId, invoiceId, position])
}

model InvoicePayment {
  id               String                   @id @default(cuid())
  businessId       String
  invoiceId        String
  amountCents      Int
  method           PaymentMethod
  reference        String?
  receivedAt       DateTime
  notes            String?
  createdBy        String?
  createdAt        DateTime                 @default(now())
  reversedAt       DateTime?
  reversalReason   String?
  business         Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice          Invoice                  @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Restrict)
  creator          User?                    @relation("InvoicePaymentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  receiptDocuments InvoiceReceiptDocument[]
  communications   CustomerCommunication[]

  @@unique([id, businessId])
  @@index([businessId, invoiceId])
  @@index([businessId, receivedAt])
  @@map("Payment")
}

model InvoiceReceiptDocument {
  id            String         @id @default(cuid())
  businessId    String
  invoiceId     String
  paymentId     String
  receiptNumber String
  fileName      String
  mimeType      String
  fileSizeBytes Int
  checksum      String
  objectKey     String
  generatedAt   DateTime       @default(now())
  createdBy     String?
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice       Invoice        @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Cascade)
  payment       InvoicePayment @relation(fields: [paymentId, businessId], references: [id, businessId], onDelete: Cascade)
  creator       User?          @relation("InvoiceReceiptDocumentCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([businessId, receiptNumber])
  @@unique([businessId, paymentId])
  @@unique([businessId, objectKey])
  @@index([businessId, invoiceId])
  @@index([businessId, paymentId])
}

model InvoicePdfDocument {
  id            String   @id @default(cuid())
  businessId    String
  invoiceId     String
  version       Int
  fileName      String
  mimeType      String
  fileSizeBytes Int
  checksum      String
  objectKey     String
  generatedAt   DateTime @default(now())
  createdBy     String?
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice       Invoice  @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, invoiceId, version])
  @@unique([businessId, objectKey])
  @@index([businessId, invoiceId])
}

model InvoicePublicAccessToken {
  id           String    @id @default(cuid())
  businessId   String
  invoiceId    String
  version      Int
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
  viewCount    Int       @default(0)
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice      Invoice   @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([businessId, invoiceId, version])
  @@index([expiresAt])
}

model InvoiceSequence {
  businessId String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ReceiptSequence {
  businessId String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessCommunicationSettings {
  businessId                      String   @id
  appointmentConfirmationsEnabled Boolean  @default(true)
  appointmentRemindersEnabled     Boolean  @default(true)
  appointmentReminderLeadMinutes  Int      @default(1440)
  quoteFollowUpsEnabled           Boolean  @default(true)
  quoteFollowUpDelayMinutes       Int      @default(4320)
  invoiceDueSoonRemindersEnabled  Boolean  @default(true)
  invoiceDueSoonLeadMinutes       Int      @default(4320)
  invoiceOverdueRemindersEnabled  Boolean  @default(true)
  invoiceOverdueDelayMinutes      Int      @default(1440)
  paymentConfirmationsEnabled     Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  business                        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model CustomerCommunicationPreference {
  id           String   @id @default(cuid())
  businessId   String
  customerId   String
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, customerId])
  @@unique([customerId, businessId])
  @@index([businessId, emailEnabled, smsEnabled])
}

model CustomerCommunication {
  id                   String                       @id @default(cuid())
  businessId           String
  customerId           String
  channel              CustomerCommunicationChannel
  type                 CustomerCommunicationType
  status               CustomerCommunicationStatus  @default(DRAFT)
  recipient            String
  subject              String?
  message              String
  preview              String?
  relatedJobId         String?
  relatedAppointmentId String?
  relatedQuoteId       String?
  relatedInvoiceId     String?
  relatedPaymentId     String?
  idempotencyKey       String
  scheduledFor         DateTime?
  processingStartedAt  DateTime?
  processingExpiresAt  DateTime?
  sentAt               DateTime?
  failedAt             DateTime?
  failureReason        String?
  provider             String?
  providerMessageId    String?
  cancelledAt          DateTime?
  createdBy            String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  business             Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             Customer                     @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  job                  Job?                         @relation(fields: [relatedJobId, businessId], references: [id, businessId], onDelete: Restrict)
  appointment          Appointment?                 @relation(fields: [relatedAppointmentId, businessId], references: [id, businessId], onDelete: Restrict)
  quote                Quote?                       @relation(fields: [relatedQuoteId, businessId], references: [id, businessId], onDelete: Restrict)
  invoice              Invoice?                     @relation(fields: [relatedInvoiceId, businessId], references: [id, businessId], onDelete: Restrict)
  payment              InvoicePayment?              @relation(fields: [relatedPaymentId, businessId], references: [id, businessId], onDelete: Restrict)
  creator              User?                        @relation("CustomerCommunicationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, status, scheduledFor])
  @@index([businessId, status, processingExpiresAt])
  @@index([businessId, relatedAppointmentId])
  @@index([businessId, relatedQuoteId])
  @@index([businessId, relatedInvoiceId])
  @@index([businessId, relatedPaymentId])
  @@index([businessId, provider, providerMessageId])
}

model Message {
  id          String           @id @default(cuid())
  businessId  String
  customerId  String?
  jobId       String?
  channel     MessageChannel
  direction   MessageDirection
  status      MessageStatus    @default(DRAFT)
  recipient   String?
  subject     String?
  body        String
  confirmedBy String?
  confirmedAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer?        @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  job         Job?             @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, status, createdAt])
  @@index([businessId, customerId])
}

model Notification {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  title      String
  body       String
  status     NotificationStatus @default(UNREAD)
  readAt     DateTime?
  createdAt  DateTime           @default(now())
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, userId, status])
}

model AiConversation {
  id         String      @id @default(cuid())
  businessId String
  userId     String
  title      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId, businessId], references: [id, businessId], onDelete: Cascade)
  messages   AiMessage[]
  actions    AiAction[]

  @@unique([id, businessId])
  @@index([businessId, userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  businessId     String
  conversationId String
  role           AiMessageRole
  content        String
  createdAt      DateTime       @default(now())
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   AiConversation @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, conversationId, createdAt])
}

model AiAction {
  id             String         @id @default(cuid())
  businessId     String
  conversationId String
  type           AiActionType
  status         AiActionStatus @default(DRAFT)
  payload        Json
  confirmedBy    String?
  confirmedAt    DateTime?
  executedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   AiConversation @relation(fields: [conversationId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId, status, createdAt])
  @@index([businessId, conversationId])
}

model Document {
  id         String   @id @default(cuid())
  businessId String
  jobId      String?
  name       String
  mimeType   String
  storageKey String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job        Job?     @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, storageKey])
  @@index([businessId, jobId])
}

model MediaAsset {
  id                 String           @id @default(cuid())
  businessId         String
  customerId         String?
  jobId              String?
  appointmentId      String?
  uploadedByUserId   String
  category           MediaCategory
  mediaType          MediaType
  originalFileName   String
  objectKey          String
  storageProvider    String
  mimeType           String
  fileSizeBytes      Int
  width              Int?
  height             Int?
  durationSeconds    Int?
  checksum           String?
  caption            String?
  notes              String?
  isCustomerVisible  Boolean          @default(false)
  uploadStatus       UploadStatus     @default(PENDING)
  processingStatus   ProcessingStatus @default(NOT_REQUIRED)
  thumbnailObjectKey String?
  archivedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?        @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  job                Job?             @relation(fields: [jobId, businessId], references: [id, businessId], onDelete: Restrict)
  appointment        Appointment?     @relation(fields: [appointmentId, businessId], references: [id, businessId], onDelete: Restrict)
  uploadedBy         User             @relation("MediaAssetUploader", fields: [uploadedByUserId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([businessId, objectKey])
  @@index([businessId, customerId, createdAt])
  @@index([businessId, jobId, createdAt])
  @@index([businessId, appointmentId, createdAt])
  @@index([businessId, category, createdAt])
  @@index([businessId, mediaType, createdAt])
  @@index([businessId, uploadedByUserId, createdAt])
  @@index([businessId, uploadStatus, createdAt])
  @@index([businessId, archivedAt])
}

model Integration {
  id          String   @id @default(cuid())
  businessId  String
  provider    String
  externalId  String?
  credentials Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@index([businessId, isActive])
}
