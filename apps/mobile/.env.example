# Desktop web can use localhost. For Expo Go on a physical phone, replace
# localhost with your computer LAN IP, for example http://192.168.0.234:3000/api.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Optional. If omitted in development, the app calls /api/auth/demo-token after
# you run `pnpm db:seed`.
EXPO_PUBLIC_DEMO_AUTH_TOKEN=
